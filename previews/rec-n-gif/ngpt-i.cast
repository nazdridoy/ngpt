[0.006, "o", "\u001b[33m  \u001b[0m\u001b[1;36mSession Commands (prefix with '/'):             \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37m                                            \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m/editor                                         \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37mOpen multiline editor                       \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m/exit                                           \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37mEnd session                                 \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m/help                                           \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37mShow this help message                      \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m/reset                                          \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37mReset Session                               \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m/sessions                                       \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37mManage saved sessions                       \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m/transcript                                     \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37mShow recent conversation exchanges          \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[33m                                                \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37m                                            \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0m\u001b[1;36mKeyboard Shortcuts:                             \u001b[0m\u001b[33m  \u001b[0m\u001b[37m  \u001b[0m\u001b[37m                                            \u001b[0m\u001b[37m  \u001b[0m\r\n\u001b[33m  \u001b[0