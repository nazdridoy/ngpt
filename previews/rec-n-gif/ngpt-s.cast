                                                \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m Without quotes, \u001b[1;36;40mzsh\u001b[0m treats \u001b[1;36;40mMy\u001b[0m and \u001b[1;36;40mSong.mp3\u001b[0m as two separate arguments, leading to a \"No such file or directory\" error.                     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35mSummary\u001b[0m                                                                                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b"]
