[0.000, "o", ".                                                        \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m 3 \u001b[0m\u001b[1mEncoding\u001b[0m: It encodes the frames into the WAV format (typically PCM).                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m 4 \u001b[0m\u001b[1mMuxing\u001b[0m: It wraps the encoded audio into a \u001b[1;36;40m.wav\u001b[0m file structure and writes it to your disk.                                              \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m3. Environment Specifics (CachyOS & zsh)\u001b[0m                                                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mPerformance\u001b[0m: Since CachyOS is optimized for performance (often using the \u001b[1;36;40mx86-64-v3\u001b[0m or \u001b[1;36;40mv4\u001b[0m instruction sets and the BORE scheduler),     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0mFFmpeg will likely run very efficiently, especially if you are processing large batches of files.                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mzsh Globbing\u001b[0m: If you were to use wildcards (e.g., \u001b[1;36;40mffmpeg -i *.mp3 ...\u001b[0m), \u001b[1;36;40mzsh\u001b[0m behaves differently than \u001b[1;36;40mbash\u001b[0m. If no \u001b[1;36;40m.mp3\u001b[0m files are found, \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0m\u001b[1;36;40mzsh\u001b[0m will return an error (\u001b[1;36;40mzsh: no matches found\u001b[0m) and refuse to run the command, whereas \u001b[1;36;40mbash\u001b[0m might pass the literal string \u001b[1;36;40m*.mp3\u001b[0m to    \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0mthe program.                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mInstallation\u001b[0m: If the command is not found, you can install it on CachyOS using:                                                        \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0m\u001b[48;2;39;40;34m                                                                                                                                      \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0m\u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34msudo\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mpacman\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m-S\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mffmpeg\u001b[0m\u001b[48;2;39;40;34m                                                                                                               \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0m\u001b[48;2;39;40;34m                                                                                                                                      \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m4. Risks and Side Effects\u001b[0m                                                                                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mFile Size\u001b[0m: This is the most significant side effect. MP3 is a \"lossy\" compressed format, while WAV is typically \"lossless\" and         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0muncompressed. \u001b[1mThe resulting \u001b[0m\u001b[1;36;40m.wav\u001b[0m\u001b[1m file will be significantly larger\u001b[0m (often 5 to 10 times larger) than the original \u001b[1;36;40m.mp3\u001b[0m.                \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mQuality\u001b[0m: Converting from MP3 to WAV \u001b[1mdoes not improve audio quality\u001b[0m. You cannot \"recover\" the data lost dur"]
[0.000, "o", "ing the original MP3         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0mcompression. You are simply putting lower-quality audio into a larger, uncompressed container.                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mOverwriting\u001b[0m: If a file named \u001b[1;36;40moutput.wav\u001b[0m already exists in your folder, FFmpeg will ask: \u001b[1;36;40mFile 'output.wav' already exists. Overwrite? \u001b[0m  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0m\u001b[1;36;40m[y/N]\u001b[0m.                                                                                                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0m\u001b[1m • \u001b[0m\u001b[3mTip:\u001b[0m If you want to force overwrite without asking, add the \u001b[1;36;40m-y\u001b[0m flag: \u001b[1;36;40mffmpeg -y -i input.mp3 output.wav\u001b[0m.                             \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mMetadata\u001b[0m: While FFmpeg tries to preserve metadata (Artist, Album, etc.), WAV files have inconsistent support for metadata tags         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0mcompared to MP3s. Some audio players might not show the song info correctly after conversion.                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m5. Common zsh \"Gotchas\"\u001b[0m                                                                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m If your filename has spaces (e.g., \u001b[1;36;40mMy Song.mp3\u001b[0m), the command will fail in \u001b[1;36;40mzsh\u001b[0m unless you quote the filename:                              \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mffmpeg\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m-i\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;230;219;116;48;2;39;40;34m\"My Song.mp3\"\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;230;219;116;48;2;39;40;34m\"My Song.wav\"\u001b[0m\u001b[48;2;39;40;34m                                                                                                  \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m Without quotes, \u001b[1;36;40mzsh\u001b[0m treats \u001b[1;36;40mMy\u001b[0m and \u001b[1;36;40mSong.mp3\u001b[0m as two separate arguments, leading to a \"No such file or directory\" error.                     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35mSummary\u001b[0m                                                                                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m This is a safe, standard command used to convert a compressed MP3 into an uncompressed WAV file. It is commonly used when you need to     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m edit audio in software that prefers raw waveforms or when burning a high-compatibility CD.                                          "]
