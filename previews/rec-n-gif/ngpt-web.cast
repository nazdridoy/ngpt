                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m8. Where to Learn More\u001b[0m                                                                                                                    \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                      "]
