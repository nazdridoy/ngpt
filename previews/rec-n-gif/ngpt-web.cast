m\u001b[1mInteractive chat\u001b[0m           \u001b[36m \u001b[0mContinuous conversation with memory and a modern \u001b[36m \u001b[0m\u001b[1;36;40mngpt -i\u001b[0m                                           \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mUI                                               \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m"]
