                         \u001b[36m \u001b[0m\u001b[1;36;40m1.0\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--max_tokens\u001b[0m         \u001b[36m \u001b[0mToken limit                          \u001b[36m \u001b[0m\u001b[1;36;40m2000\u001b[0m                     \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--log\u001b[0m                \u001b[36m \u001b[0mLog conversation to file             \u001b[36m \u001b[0m\u001b[1;36;40mconvo.txt\u001b[0m                \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--preprompt\u001b[0m / \u001b[1;36;40m--role\u001b[0m \u001b[36m \u001b[0mCustom system prompt or role         \u001b[36m \u001b[0m\u001b[1;36;40m--role=dev\u001b[0m               \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--config\u001b[0m             \u001b[36m \u001b[0mPath to config file                  \u001b[36m \u001b[0m\u001b[1;36;40m~/.ngpt/config.yaml\u001b[0m      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--config-index\u001b[0m       \u001b[36m \u001b[0mIndex of config profile              \u001b[36m \u001b[0m\u001b[1;36;40m0\u001b[0m                        \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--list-models\u001b[0m        \u001b[36m \u001b[0mShow available models                \u001b[36m \u001b[0m\u001b[1;36;40m--list-models\u001b[0m            \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--plaintext\u001b[0m          \u001b[36m \u001b[0mDisable streaming & markdown         \u001b[36m \u001b[0m\u001b[1;36;40m--plaintext\u001b[0m              \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--language\u001b[0m           \u001b[36m \u001b[0mTarget language for code mode        \u001b[36m \u001b[0m\u001b[1;36;40mpython\u001b[0m                   \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--chunk-size\u001b[0m         \u001b[36m \u001b[0mLines per chunk for diff processing  \u001b[36m \u001b[0m\u001b[1;36;40m200\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--humanize\u001b[0m           \u001b[36m \u001b[0mMake output more human‑like          \u001b[36m \u001b[0m\u001b[1;36;40m--humanize\u001b[0m               \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                       \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m The CLI also supports mutually exclusive \u001b[3mmodes\u001b[0m such as \u001b[1;36;40m-i/--interactive\u001b[0m, \u001b[1;36;40m-s/--shell\u001b[0m, \u001b[1;36;40m-c/--code\u001b[0m, \u001b[1;36;40m-t/--text\u001b[0m, \u001b[1;36;40m-r/--rewrite\u001b[0m, and              \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;36;40m-g/--gitcommsg\u001b[0m.  Each mode can be combined with the flags above to tailor the experience.                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
