[0.004, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[36m╭─\u001b[0m\u001b[1;36m 🤖 nGPT \u001b[0m\u001b[36m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m ngpt --config-index 1  # edit the second profile ngpt --remove 0        # delete the first profile                                        \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[48;2;39;40;34m                                                                                                                                       \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mCustom *roles* let you pre‑define system prompts for recurring tasks:\u001b[0m\u001b[48;2;39;40;34m                                                                  \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[48;2;39;40;34m                                                                                                                                       \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m```bash\u001b[0m\u001b[48;2;39;40;34m                                                                                                                                \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt --role-config create dev \"You are a senior Python developer.\"\u001b[0m\u001b[48;2;39;40;34m                                                                     \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt --role dev \"Write a unit test for this function.\"\u001b[0m\u001b[48;2;39;40;34m                                                                                 \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m    