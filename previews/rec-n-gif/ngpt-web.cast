[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m6. Advanced Usage\u001b[0m                                                                                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mSession Management\u001b[0m – Save, load, and list interactive chat sessions. Commands like \u001b[1;36;40m/sessions\u001b[0m, \u001b[1;36;40m/load\u001b[0m, \u001b[1;36;40m/rename\u001b[0m"]
