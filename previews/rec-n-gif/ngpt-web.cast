[0.007, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[36m╭─\u001b[0m\u001b[1;36m 🤖 nGPT \u001b[0m\u001b[36m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m | \u001b[1mShell\u001b[0m | \u001b[1;36;40mngpt --shell \"list all files\"\u001b[0m | Produces a shell command (optionally executes) | | \u001b[1mRewrite\u001b[0m | \u001b[1;36;40mngpt --rewrite file.txt\u001b[0m | Rewrites \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m the file’s content | | \u001b[1mGit commit\u001b[0m | \u001b[1;36;40mngpt --gitcommsg\u001b[0m | Generates a commit message from staged changes | | \u001b[1mWeb‑search prompt\u001b[0m | \u001b[1;36;40mngpt \u001b[0m       \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;36;40m--web-search \"Explain relativity\"\u001b[0m | Adds web context to the prompt |                                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m------------------------------------------------------------------------------------------