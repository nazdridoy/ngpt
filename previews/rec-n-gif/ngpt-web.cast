       \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mMarkdown rendering\u001b[0m           \u001b[36m \u001b[0mLive syntax‑highlighted output for     \u001b[36m \u001b[0m(default behaviour)                   \u001b[36m \u001b[0m[2]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                             \u001b[36m \u001b[0mcode and markdown                      \u001b[36m \u001b[0m                                      \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mMultiple configurations\u001b[0m      \u001b[36m \u001b[0mProfile‑based settings, provider       \u001b[36m \u001b[0m\u001b[1;36;40mngpt --config ~/.ngpt/config.yaml\u001b[0m     \u001b[36m \u001b[0m[4]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                             \u001b[36m \u001b[0mswitching, custom roles                \u001b[36m \u001b[0m                                      \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mLogging & session management\u001b[0m \u001b[36m \u001b[0mSave conversations, load previous      \u001b[36m \u001b[0m\u001b[1;36;40mngpt --log convo.txt\u001b[0m                  \u001b[36m \u001b[0m[4]                       \u001b[36m \u001b[0m"]
