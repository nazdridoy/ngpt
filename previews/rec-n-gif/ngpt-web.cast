[0.007, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[36m╭─\u001b[0m\u001b[1;36m 🤖 nGPT \u001b[0m\u001b[36m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m | \u001b[1mShell\u001b[0m | \u001b[1;36;40mngpt --shell \"list all files\"\u001b[0m | Produces a shell command (optionally executes) | | \u001b[1mRewrite\u001b[0m | \u001b[1;36;40mngpt --rewrite file.txt\u001b[0m | Rewrites \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m the file’s content | | \u001b[1mGit commit\u001b[0m | \u001b[1;36;40mngpt --gitcommsg\u001b[0m | Generates a commit message from staged changes | | \u001b[1mWeb‑search prompt\u001b[0m | \u001b[1;36;40mngpt \u001b[0m       \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;36;40m--web-search \"Explain relativity\"\u001b[0m | Adds web context to the prompt |                                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m4. Command‑Line Options Overview\u001b[0m                                                                                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m The CLI offers a rich set of flags (see the full list in the usage guide) that control everything from model selection to output          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m formatting:                                                                                                                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                       \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mFlag\u001b[0m\u001b[1m                \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mPurpose\u001b[0m\u001b[1m                             \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mTypical Value\u001b[0m\u001b[1m            \u001b[0m\u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ───────────────────────────────────────────────────────────────────────────────────── \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--api-key\u001b[0m            \u001b[36m \u001b[0mAPI key for the chosen provider      \u001b[36m \u001b[0m\u001b[1;36;40msk-…\u001b[0m                     \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--base-url\u001b[0m           \u001b[36m \u001b[0mCustom endpoint URL                  \u001b[36m \u001b[0m\u001b[1;36;40mhttps://api.openai.com/v1\u001b[0m\u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--model\u001b[0m              \u001b[36m \u001b[0mModel name                           \u001b[36m \u001b[0m\u001b[1;36;40mgpt-4o\u001b[0m                   \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--provider\u001b[0m           \u001b[36m \u001b[0mProvider name (OpenAI, Ollama, etc.) \u001b[36m \u001b[0m\u001b[1;36;40mopenai\u001b[0m                   \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--temperature\u001b[0m        \u001b[36m \u001b[0mRandomness                           \u001b[36m \u001b[0m\u001b[1;36;40m0.7\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--top_p\u001b[0m              \u001b[36m \u001b[0mDiversity                            \u001b[36m \u001b[0m\u001b[1;36;40m1.0\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--max_tokens\u001b[0m         \u001b[36m \u001b[0mToken limit                          \u001b[36m \u001b[0m\u001b[1;36;40m2000\u001b[0m                     \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--log\u001b[0m                \u001b[36m \u001b[0mLog conversation to file             \u001b[36m \u001b[0m\u001b[1;36;40mconvo.txt\u001b[0m                \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--preprompt\u001b[0m / \u001b[1;36;40m--role\u001b[0m \u001b[36m \u001b[0mCustom system prompt or role         \u001b[36m \u001b[0m\u001b[1;36;40m--role=dev\u001b[0m               \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--config\u001b[0m             \u001b[36m \u001b[0mPath to config file                  \u001b[36m \u001b[0m\u001b[1;36;40m~/.ngpt/config.yaml\u001b[0m      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--config-index\u001b[0m       \u001b[36m \u001b[0mIndex                                \u001b[36m \u001b[0m                         \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                       \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
