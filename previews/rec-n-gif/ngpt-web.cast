[0.009, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[36m╭─\u001b[0m\u001b[1;36m 🤖 nGPT \u001b[0m\u001b[36m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1mngpt CLI – a lightning‑fast, all‑in‑one LLM toolkit for the terminal\u001b[0m                                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m ngpt (short for \u001b[3mnGPT\u001b[0m) is a command‑line interface that lets you tap any OpenAI‑compatible large language model (OpenAI, Ollama, Groq,     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m Claude, Gemini, etc.) directly from your shell. It’s designed to be lightweight, fast, and versatile, covering a wide range of AI‑driven  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m tasks such as chat, code generation, git commit message creation, shell command synthesis, text rewriting, and even web‑search‑augmented  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m prompts.                                                                                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m1. Core Features\u001b[0m                                                                                                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mFeature\u001b[0m\u001b[1m                   \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mWhat it does\u001b[0m\u001b[1m                          \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mExample\u001b[0m\u001b[1m                                \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mSource\u001b[0m\u001b[1m                    \u001b[0m\u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── \u001b[0m \u001b[36m