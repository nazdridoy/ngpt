 web‑search‑augmented  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m prompts.                                                                                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m1. Core Features\u001b[0m                                                                                                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mFeature\u001b[0m\u001b[1m                   \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mWhat it does\u001b[0m\u001b[1m                          \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mExample\u001b[0m\u001b[1m                                \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mSource\u001b[0m\u001b[1m                    \u001b[0m\u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mInteractive chat\u001b[0m           \u001b[36m \u001b[0mContinuous conversation with memory    \u001b[36m \u001b[0m\u001b[1;36;40mngpt -i\u001b[0m                                 \u001b[36m \u001b[0m[1]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mand a modern UI                        \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m "]
[0.000, "o", "                         \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode generation\u001b[0m            \u001b[36m \u001b[0mProduce code snippets or full programs \u001b[36m \u001b[0m\u001b[1;36;40mngpt --code \"function to calculate \u001b[0m     \u001b[36m \u001b[0m[2]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mwith optional syntax highlighting      \u001b[36m \u001b[0m\u001b[1;36;40mFibonacci\"\u001b[0m                              \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mShell command synthesis\u001b[0m    \u001b[36m \u001b[0mGenerate and optionally execute        \u001b[36m \u001b[0m\u001b[1;36;40mngpt --shell \"list all files in the \u001b[0m    \u001b[36m \u001b[0m[2]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mOS‑aware shell commands                \u001b[36m \u001b[0m\u001b[1;36;40mcurrent directory\"\u001b[0m                      \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mGit commit messages\u001b[0m        \u001b[36m \u001b[0mAI‑powered conventional commit         \u001b[36m \u001b[0m\u001b[1;36;40mngpt --gitcommsg\u001b[0m (or \u001b[1;36;40mngpt -g\u001b[0m)           \u001b[36m \u001b[0m[4]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mmessages from staged changes or diffs  \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mRewrite & text improvement\u001b[0m \u001b[36m \u001b[0mTransform text to be more natural      \u001b[36m \u001b[0m\u001b[1;36;40mngpt --rewrite <file>\u001b[0m                   \u001b[36m \u001b[0m[1]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mwhile preserving tone                  \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mWeb search\u001b[0m                 \u001b[36m \u001b[0mAugment prompts with relevant          \u001b[36m \u001b[0m\u001b[1;36;40mngpt --web-search \"Explain quantum \u001b[0m     \u001b[36m \u001b[0m[1]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mDuckDuckGo results and content         \u001b[36m \u001b[0m\u001b[1;36;40mtunneling\"\u001b[0m                              \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mextraction                             \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mPiping & stdin\u001b[0m             \u001b[36m \u001b[0mUse \u001b[1;36;40m{}\u001b[0m placeholder to embed piped      \u001b[36m \u001b[0m`echo \"text\"                            \u001b[36m \u001b[0mngpt --pipe \"Analyze: {}\"`\u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mcontent into prompts                   \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mMarkdown rendering\u001b[0m         \u001b[36m \u001b[0mLive syntax‑highlighted output for     \u001b[36m \u001b[0m(default behaviour)                     \u001b[36m \u001b[0m[2]                       \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mcode and markdown                      \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mMultiple configurations\u001b[0m    \u001b[36m \u001b[0mProfile‑based settings, provider       \u001b[36m \u001b[0m`ngpt --config ~/.ng                    \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mswitching, custom roles                \u001b[36m \u001b[0m                                        \u001b[36m \u001b[0m                          \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                             "]
