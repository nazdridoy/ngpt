r \u001b[1;36;40mngpt -g\u001b[0m)                     \u001b[36m \u001b[0m[4]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mstaged changes or diffs                          \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mRewrite & text improvement\u001b[0m \u001b[36m \u001b[0mTransform text to be more natural while          \u001b[36m \u001b[0m\u001b[1;36;40mngpt --rewrite <file>\u001b[0m                             \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mpreserving tone                                  \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mWeb search\u001b[0m                 \u001b[36m \u001b[0mAugment prompts with relevant DuckDuckGo results \u001b[36m \u001b[0m\u001b[1;36;40mngpt --web-search \"Explain quantum tunneling\"\u001b[0m     \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mand content extraction                           \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mPiping & stdin\u001b[0m             \u001b[36m \u001b[0mUse \u001b[1;36;40m{}\u001b[0m placeholder to embed piped content into   \u001b[36m \u001b[0m`                                                 \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mprompts                                          \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
[0.008, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[36m╭─\u001b[0m\u001b[1;36m 🤖 nGPT \u001b[0m\u001b[36m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1mngpt CLI – a lightning‑fast, all‑in‑one LLM toolkit for the terminal\u001b[0m                                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m ngpt (short for \u001b[3mnGPT\u001b[0m) is a command‑line interface that lets you tap any OpenAI‑compatible large language model (OpenAI, Ollama, Groq,     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m Claude, Gemini, etc.) directly from your shell. It’s designed to be lightweight, fast, and versatile, covering a wide range of AI‑driven  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m tasks such as chat, code generation, git commit message creation, shell command synthesis, text rewriting, and even web‑search‑augmented  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m prompts.              