b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--api-key\u001b[0m  \u001b[36m \u001b[0mAPI key for the chosen provider \u001b[36m \u001b[0m\u001b[1;36;40msk-…\u001b[0m                     \u001b[36m \u001b[0m                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--base-url\u001b[0m \u001b[36m \u001b[0mCustom endpoint URL             \u001b[36m \u001b[0m\u001b[1;36;40mhttps://api.openai.com/v1\u001b[0m\u001b[36m \u001b[0m                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--model\u001b[0m    \u001b[36m \u001b[0mModel name                      \u001b[36m \u001b[0m\u001b[1;36;40mgpt-4o\u001b[0m                   \u001b[36m \u001b[0m                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--provider\u001b[0m \u001b[36m \u001b[0mProvider name (OpenAI, Ollama,  \u001b[36m \u001b[0m                         \u001b[36m \u001b[0m                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                        \u001b[0m                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
