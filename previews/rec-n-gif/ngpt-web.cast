           \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode generation\u001b[0m  \u001b[36m \u001b[0mProduce code snippets or full programs with optional syntax    \u001b[36m \u001b[0m\u001b[1;36;40mngpt --code \"function to calculate Fibonacci\"\u001b[0m \u001b[36m \u001b[0m[     \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                 \u001b[36m \u001b[0mhighlighting  "]
