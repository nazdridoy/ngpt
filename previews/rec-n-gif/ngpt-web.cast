                                                                                                                       \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m1. Core Features\u001b[0m                                                                                                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mFeature\u001b[0m\u001b[1m                \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mWhat it does\u001b[0m\u001b[1m                                           \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mExample\u001b[0m\u001b[1m                                      \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mSource\u001b[0m\u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mInteractive chat\u001b[0m        \u001b[36m \u001b[0mContinuous conversation with memory and a modern UI     \u001b[36m \u001b[0m\u001b[1;36;40mngpt -i\u001b[0m                                       \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode generation\u001b[0m         \u001b[36m \u001b[0mProduce code snippets or full programs with optional    \u001b[36m \u001b[0m\u001b[1;36;40mngpt --code \"function to calculate Fibonacci\"\u001b[0m \u001b[36m \u001b[0m[2]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                        \u001b[36m \u001b[0"]
