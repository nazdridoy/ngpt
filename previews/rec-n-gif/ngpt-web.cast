                                     \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m | Flag | Purpose |                                                                                                                        \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
