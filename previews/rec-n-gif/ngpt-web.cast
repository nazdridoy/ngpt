[0.008, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[36m╭─\u001b[0m\u001b[1;36m 🤖 nGPT \u001b[0m\u001b[36m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                           \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mMode\u001b[0m\u001b[1m             \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mCommand\u001b[0m\u001b[1m                               \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mWhat it does\u001b[0m\u001b[1m                                  \u001b[0m\u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ───────────────────────────────────────────────────────────────────────────────────────────────────────── \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mChat\u001b[0m              \u001b[36m \u001b[0m\u001b[1;36;40mngpt \"Tell me about quantum computing\"\u001b[0m \u001b[36m \u001b[0mSimple one‑shot prompt                        \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mInteractive chat\u001b[0m  \u001b[36m \u001b[0m\u001b[1;36;40mngpt -i\u001b[0m                                \u001b[36m \u001b[0mStarts a session with conversation memory     \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode\u001b[0m              \u001b[36m \u001b[0m\u001b[1;36;40mngpt --code \"create a python request\"\u001b[0m  \u001b[36m \u001b[0mGenerates clean Python code                   \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mShell\u001b[0m             \u001b[36m \u001b[0m\u001b[1;36;40mngpt --shell \"list all files\"\u001b[0m          \u001b[36m \u001b[0mProduces a shell command (optionally executes)\u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mRewrite\u001b[0m           \u001b[36m \u001b[0m\u001b[1;36;40mngpt --rewrite file.txt\u001b[0m                \u001b[36m \u001b[0mRewrites the file’s content                   \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mGit commit\u001b[0m        \u001b[36m \u001b[0m\u001b[1;36;40mngpt --gitcommsg\u001b[0m                       \u001b[36m \u001b[0mGenerates a commit message from staged changes\u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mWeb‑search prompt\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40mngpt --web-search \"Explain relativity\"\u001b[0m \u001b[36m \u001b[0mAdds web context to the prompt                \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                           \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b"]
