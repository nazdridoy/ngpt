6;40mngpt -i\u001b[0m                                            \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                        \u001b[36m \u001b[0mUI                                                 \u001b[36m \u001b[0m                                                   \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode generation\u001b[0m         \u001b[36m \u001b"]
