0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ───────────────────────────────────────────────────────────────────────────────────── \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--api-key\u001b[0m            \u001b[36m \u001b[0mAPI key for the chosen provider      \u001b[36m \u001b[0m\u001b[1;36;40msk-…\u001b[0m                     \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--base-url\u001b[0m           \u001b[36m \u001b[0mCustom end"]
