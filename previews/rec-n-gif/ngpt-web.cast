                  \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mpip\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34minstall\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m          \u001b[0m\u001b[38;2;149;144;119;48;2;39;40;34m# or\u001b[0m\u001b[48;2;39;40;34m                                                                                                         \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34muv\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mpip\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34minstall\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[48;2;39;40;34m                                                                                                                    \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m For a system‑wide CLI installation:                                                                                                       \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34muv\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mtool\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34minstall\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[48;2;39;40;34m                                                                                                                   \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m Arch Linux users can pull the AUR package:                                                                                                \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mparu\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m-S\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[48;2;39;40;34m                                                                                                                           \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m All installations require \u001b[1mPython ≥ 3.8\u001b[0m.  Detailed instructions are on the \u001b]8;id=831619;https://nazdridoy.github.io/ngpt/installation/\u001b\\\u001b[4;34mofficial docs\u001b[0m\u001b]8;;\u001b\\ (see source [2]).                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m3. Quick‑Start Commands\u001b[0m                                                                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                           \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mMode\u001b[0m\u001b[1m             \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mCommand\u001b[0m\u001b[1m                               \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mWhat it does\u001b[0m\u001b[1m                                  \u001b[0m\u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ───────────────────────────────────────────────────────────────────────────────────────────────────────── \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mChat\u001b[0m              \u001b[36m \u001b[0m\u001b[1;36;40mngpt \"Tell me about quantum computing\"\u001b[0m \u001b[36m \u001b[0mSimple one‑shot prompt                        \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mInteractive chat\u001b[0m  \u001b[36m \u001b[0m\u001b[1;36;40mngpt -i\u001b[0m                                \u001b[36m \u001b[0mStarts a session with conversation memory     \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode\u001b[0m              \u001b[36m \u001b[0m\u001b[1;36;40mngpt --code \"create a python request\"\u001b[0m  \u001b[36m \u001b[0mGenerates clean Python code                   \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mShell\u001b[0m             \u001b[36m \u001b[0m\u001b[1;36;40mngpt --shell \"list all files\"\u001b[0m          \u001b[36m \u001b[0mProduces a shell command (optionally executes)\u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mRewrite\u001b[0m           \u001b[36m \u001b[0m\u001b[1;36;40mngpt --rewrite file.txt\u001b[0m                \u001b[36m \u001b[0mRewrites the file’s content                   \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mGit commit\u001b[0m        \u001b[36m \u001b[0m\u001b[1;36;40mngpt --gitcommsg\u001b[0m                       \u001b[36m \u001b[0mGenerates a commit message from staged changes\u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mWeb‑search prompt\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40mngpt --web-search \"Explain relativity\"\u001b[0m \u001b[36m \u001b[0mAdds web context to the prompt                \u001b[36m \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                           \u001b[0m                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m4. Command‑Line Options Overview\u001b[0m                                                                                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m The CLI offers a rich set of flags (see the full list in the usage guide) that control everything from model selection to output          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m formatting:                                                                                                                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                       \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[36mFlag\u001b[0m\u001b[1m                \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mPurpose\u001b[0m\u001b[1m                             \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mTypical Value\u001b[0m\u001b[1m            \u001b[0m\u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m ───────────────────────────────────────────────────────────────────────────────────── \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--api-key\u001b[0m            \u001b[36m \u001b[0mAPI key for the chosen provider      \u001b[36m \u001b[0m\u001b[1;36;40msk-…\u001b[0m                     \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--base-url\u001b[0m           \u001b[36m \u001b[0mCustom endpoint URL                  \u001b[36m \u001b[0m\u001b[1;36;40mhttps://api.openai.com/v1\u001b[0m\u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--model\u001b[0m              \u001b[36m \u001b[0mModel name                           \u001b[36m \u001b[0m\u001b[1;36;40mgpt-4o\u001b[0m                   \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--provider\u001b[0m           \u001b[36m \u001b[0mProvider name (OpenAI, Ollama, etc.) \u001b[36m \u001b[0m\u001b[1;36;40mopenai\u001b[0m                   \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--temperature\u001b[0m        \u001b[36m \u001b[0mRandomness                           \u001b[36m \u001b[0m\u001b[1;36;40m0.7\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--top_p\u001b[0m              \u001b[36m \u001b[0mDiversity                            \u001b[36m \u001b[0m\u001b[1;36;40m1.0\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--max_tokens\u001b[0m         \u001b[36m \u001b[0mToken limit                          \u001b[36m \u001b[0m\u001b[1;36;40m2000\u001b[0m                     \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--log\u001b[0m                \u001b[36m \u001b[0mLog conversation to file             \u001b[36m \u001b[0m\u001b[1;36;40mconvo.txt\u001b[0m                \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--preprompt\u001b[0m / \u001b[1;36;40m--role\u001b[0m \u001b[36m \u001b[0mCustom system prompt or role         \u001b[36m \u001b[0m\u001b[1;36;40m--role=dev\u001b[0m               \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--config\u001b[0m             \u001b[36m \u001b[0mPath to config file                  \u001b[36m \u001b[0m\u001b[1;36;40m~/.ngpt/config.yaml\u001b[0m      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--config-index\u001b[0m       \u001b[36m \u001b[0mIndex of config profile              \u001b[36m \u001b[0m\u001b[1;36;40m0\u001b[0m                        \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--list-models\u001b[0m        \u001b[36m \u001b[0mShow available models                \u001b[36m \u001b[0m\u001b[1;36;40m--list-models\u001b[0m            \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--plaintext\u001b[0m          \u001b[36m \u001b[0mDisable streaming & markdown         \u001b[36m \u001b[0m\u001b[1;36;40m--plaintext\u001b[0m              \u001b[36m \u001b[0m         "]
[0.000, "o", "                                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--language\u001b[0m           \u001b[36m \u001b[0mTarget language for code mode        \u001b[36m \u001b[0m\u001b[1;36;40mpython\u001b[0m                   \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--chunk-size\u001b[0m         \u001b[36m \u001b[0mLines per chunk for diff processing  \u001b[36m \u001b[0m\u001b[1;36;40m200\u001b[0m                      \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1;36;40m--humanize\u001b[0m           \u001b[36m \u001b[0mMake output more human‑like          \u001b[36m \u001b[0m\u001b[1;36;40m--humanize\u001b[0m               \u001b[36m \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                       \u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m The CLI also supports mutually exclusive \u001b[3mmodes\u001b[0m such as \u001b[1;36;40m-i/--interactive\u001b[0m, \u001b[1;36;40m-s/--shell\u001b[0m, \u001b[1;36;40m-c/--code\u001b[0m, \u001b[1;36;40m-t/--text\u001b[0m, \u001b[1;36;40m-r/--rewrite\u001b[0m, and              \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;36;40m-g/--gitcommsg\u001b[0m.  Each mode can be combined with the flags above to tailor the experience.                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m5. Configuration & Custom Roles\u001b[0m                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m ngpt uses a cross‑platform configuration system that can store multiple profiles. You can create, edit, and switch profiles with:         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m--config\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m          \u001b[0m\u001b[38;2;149;144;119;48;2;39;40;34m# interactive config wizard\u001b[0m\u001b[48;2;39;40;34m                                                                                     \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m--config-index\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;174;129;255;48;2;39;40;34m1\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m  \u001b[0m\u001b[38;2;149;144;119;48;2;39;40;34m# edit the second profile\u001b[0m\u001b[48;2;39;40;34m                                                                                       \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m--remove\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;174;129;255;48;2;39;40;34m0\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m        \u001b[0m\u001b[38;2;149;144;119;48;2;39;40;34m# delete the first pro"]
[0.000, "o", "file\u001b[0m\u001b[48;2;39;40;34m                                                                                      \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m Custom \u001b[3mroles\u001b[0m let you pre‑define system prompts for recurring tasks:                                                                       \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m--role-config\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mcreate\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mdev\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;230;219;116;48;2;39;40;34m\"You are a senior Python developer.\"\u001b[0m\u001b[48;2;39;40;34m                                                                     \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mngpt\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m--role\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34mdev\u001b[0m\u001b[38;2;248;248;242;48;2;39;40;34m \u001b[0m\u001b[38;2;230;219;116;48;2;39;40;34m\"Write a unit test for this function.\"\u001b[0m\u001b[48;2;39;40;34m                                                                                 \u001b[0m\u001b[48;2;39;40;34m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[48;2;39;40;34m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m6. Advanced Usage\u001b[0m                                                                                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mSession Management\u001b[0m – Save, load, and list interactive chat sessions. Commands like \u001b[1;36;40m/sessions\u001b[0m, \u001b[1;36;40m/load\u001b[0m, \u001b[1;36;40m/rename\u001b[0m are available inside the  \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0minteractive mode.                                                                                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mRich Multiline Editor\u001b[0m – Press \u001b[1;36;40mCtrl+E\u001b[0m (or use \u001b[1;36;40mngpt -t\u001b[0m without a prompt) to open a full editor with syntax highlighting for complex      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m   \u001b[0minputs.                                                                                                                                \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1m • \u001b[0m\u001b[1mDiff‑Based Commit Messages\u001b[0m – Use \u001b[1;36;40m--diff file.patch\u001b[0m or let ngpt pick the staged changes automatically for git commit message            \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m"]
[0.000, "o", " \u001b[1m   \u001b[0mgeneration.                                                                                                                            \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;35m7. Performance & Architecture\u001b[0m                                                                                                             \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m ngpt is written in Python but is designed to be minimal‑dependency and highly responsive. It streams responses in real time, rendering    \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m markdown and code syntax on the fly, which is especially handy for developers who want to see results instantly.                          \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2m-----------------------------------------------------------------------------------------------------------------------------------------\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                 