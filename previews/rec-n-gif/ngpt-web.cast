[0.000, "o", "\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mCode generation\u001b[0m            \u001b[36m \u001b[0mProduce code snippets or full programs with      \u001b[36m \u001b[0m\u001b[1;36;40mngpt --code \"function to calculate Fibonacci\"\u001b[0m     \u001b[36m \u001b[0m[2]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0moptional syntax highlighting                     \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mShell command synthesis\u001b[0m    \u001b[36m \u001b[0mGenerate and optionally execute OS‑aware shell   \u001b[36m \u001b[0m\u001b[1;36;40mngpt --shell \"list all files in the current \u001b[0m      \u001b[36m \u001b[0m[2]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mcommands                                         \u001b[36m \u001b[0m\u001b[1;36;40mdirectory\"\u001b[0m                                        \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mGit commit messages\u001b[0m        \u001b[36m \u001b[0mAI‑powered conventional commit messages from     \u001b[36m \u001b[0m\u001b[1;36;40mngpt --gitcommsg\u001b[0m (or \u001b[1;36;40mngpt -g\u001b[0m)                     \u001b[36m \u001b[0m[4]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mstaged changes or diffs                          \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mRewrite & text improvement\u001b[0m \u001b[36m \u001b[0mTransform text to be more natural while          \u001b[36m \u001b[0m\u001b[1;36;40mngpt --rewrite <file>\u001b[0m                             \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mpreserving tone                                  \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mWeb search\u001b[0m                 \u001b[36m \u001b[0mAugment prompts with relevant DuckDuckGo results \u001b[36m \u001b[0m\u001b[1;36;40mngpt --web-search \"Explain quantum tunneling\"\u001b[0m     \u001b[36m \u001b[0m[1]   \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mand content extraction                           \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m\u001b[1mPiping & stdin\u001b[0m             \u001b[36m \u001b[0mUse \u001b[1;36;40m{}\u001b[0m placeholder to embed piped content into   \u001b[36m \u001b[0m`echo \"text\"                                      \u001b[36m \u001b[0mngpt  \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m \u001b[0m                           \u001b[36m \u001b[0mprompts                                          \u001b[36m \u001b[0m                                                  \u001b[36m \u001b[0m      \u001b[36m \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[36m                                                                                                                                         \u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                                                    